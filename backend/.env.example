# PolarLog - environment configuration
#
# SETUP:
#   1. Copy this file to .env in the same folder
#   2. Fill in the values below
#   3. .env is gitignored - never commit it
#
# On Windows:   copy .env.example .env
# On Mac/Linux: cp .env.example .env


# ---------- database ----------
# Your local MySQL. The database itself must already exist -
# see the README for the schema setup.
POLARLOG_DB_HOST=localhost
POLARLOG_DB_USER=root
POLARLOG_DB_PASSWORD=your_mysql_password_here
POLARLOG_DB_NAME=polarlog


# ---------- auth ----------
# Signs the session tokens. Any long random string works for
# development. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
POLARLOG_SECRET_KEY=generate_your_own_64_character_hex_string


# ---------- AI assistant ----------
# Groq runs the language model. Free, no card:
#   https://console.groq.com  ->  API Keys
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Jina produces the embeddings for document retrieval. Free, no signup -
# the key is on the page:
#   https://jina.ai/embeddings
JINA_API_KEY=jina_your_key_here
JINA_MODEL=jina-embeddings-v3


# ---------- email (password reset codes) ----------
# Optional. Leave blank while email_utils.py prints codes to the
# terminal instead of sending them.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=


# ---------- weather ----------
# Nothing needed. Open-Meteo requires no key.