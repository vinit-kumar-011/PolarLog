# Local development only - copy to backend/.env. NEVER commit the real file.
# On Railway you set these in the service's Variables tab instead.
POLARLOG_DB_HOST=localhost
POLARLOG_DB_PORT=3306
POLARLOG_DB_USER=root
POLARLOG_DB_PASSWORD=your_local_mysql_password
POLARLOG_DB_NAME=polarlog
POLARLOG_SECRET_KEY=any-long-random-string
WEATHERAPI_KEY=your_key_here
