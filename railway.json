{
  "$schema": "https://railway.com/railway.schema.json",
  "deploy": {
    "startCommand": "python backend/init_db.py; gunicorn --chdir backend app:app --bind 0.0.0.0:$PORT --workers 1 --threads 4 --timeout 120",
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE"
  }
}
